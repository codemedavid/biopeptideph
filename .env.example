# ─── Frontend (Vite) — exposed to the browser, NOT secret ──────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Backend API (serverless / api) — SECRET, server-only ──────────────────
# The access-gate / admin API talks to Supabase over HTTPS with the SERVICE-ROLE
# key (no direct Postgres connection, so no pooler / IPv6 issue on serverless).
# Find these in: Supabase Dashboard → Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — bypasses RLS, never expose to the browser

# Long random string used to sign the (stateless) session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Admin dashboard password, verified server-side by POST /api/admin/login.
# This is what lets the dashboard rotate the access code with no key to paste.
ADMIN_PASSWORD=choose-a-strong-admin-password

# Optional Bearer token for rotating the code via curl/automation/CI
# (the dashboard no longer needs it — it uses the admin session instead).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_API_KEY=replace-with-a-long-random-string

# ─── OPTIONAL: direct Postgres connection ──────────────────────────────────
# Only needed if you switch the API back to the pg data layer (import { pgDb }
# in api/index.js) or use the scripts/set-access-code.js seed script. Use the
# Supabase "Transaction" POOLER string (host aws-<n>-<region>.pooler.supabase.com,
# port 6543) — the DIRECT host db.<ref>.supabase.co is IPv6-only and fails on Vercel.
DATABASE_URL=postgres://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Only used by the one-off seed script (scripts/set-access-code.js):
#   ACCESS_CODE='your-first-code' npm run set-access-code   (needs DATABASE_URL)
# Do not commit a real value.
ACCESS_CODE=
