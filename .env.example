# ─── Frontend (Vite) — exposed to the browser, NOT secret ──────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Backend (serverless / api) — SECRET, server-only ──────────────────────
# Supabase Postgres connection string. Use the POOLER string for serverless:
# Supabase Dashboard → Settings → Database → Connection string → "Transaction"
# (host like aws-0-<region>.pooler.supabase.com, port 6543).
DATABASE_URL=postgres://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Admin dashboard password, verified server-side by POST /api/admin/login.
# This is what lets the dashboard rotate the access code with no key to paste.
ADMIN_PASSWORD=choose-a-strong-admin-password

# Optional Bearer token for rotating the code via curl/automation/CI
# (the dashboard no longer needs it — it uses the admin session instead).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_API_KEY=replace-with-a-long-random-string

# Only used by the one-off seed script (scripts/set-access-code.js):
#   ACCESS_CODE='your-first-code' npm run set-access-code
# Do not commit a real value.
ACCESS_CODE=
