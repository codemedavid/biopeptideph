        "required": true
      },
      {
        "name": "email",
        "type": "text",
        "required": true
      },
      {
        "name": "age_range",
        "type": "text",
        "required": true
      },
      {
        "name": "location",
        "type": "text",
        "required": true
      },
      {
        "name": "goals",
        "type": "text[]",
        "required": true
      },
      {
        "name": "experience_level",
        "type": "text",
        "required": true
      },
      {
