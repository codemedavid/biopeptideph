{
  "name": "Peptide Assessment V2 Duplication Data",
  "version": "1.0",
  "purpose": "Single-file source of truth for duplicating the current peptide assessment flow on another website.",
  "source_files": {
    "wizard": "src/pages/AssessmentWizardV2.tsx",
    "results_v2": "src/pages/AssessmentResultsV2.tsx",
    "results_legacy": "src/pages/AssessmentResults.tsx",
    "base_schema": "assessment_schema.sql",
    "v2_migration": "RUN_THIS_MIGRATION.sql",
    "rules_seed_v2": "seed_rules_v2.sql",
    "admin_manager": "src/components/admin/AssessmentManager.tsx"
  },
  "flow": {
    "type": "multi_step_wizard",
    "total_steps": 12,
    "result_route": "/assessment/results",
    "storage_table": "assessment_responses"
  },
  "validation": {
    "step_1": {
      "required": [
        "consent_agreed"
      ],
      "rule": "Must be true."
    },
    "step_2": {
      "required": [
        "emotional_motivators"
      ],
      "rule": "At least 1 selection required."
    },
    "step_3": {
      "required": [
        "goals"
      ],
      "rule": "At least 1 selection required."
    },
    "step_4": {
      "required": [
        "height_cm",
        "weight_kg"
      ],
      "rule": "Both required."
    },
    "step_5": {
      "required": [
        "date_of_birth",
        "sex_assigned",
        "location"
      ],
      "rule": "All required. User must be at least 18 years old."
    },
    "step_10": {
      "required": [
        "experience_level",
        "smoking_status"
      ],
      "rule": "Both required."
    },
    "step_12": {
      "required": [
        "full_name",
        "email",
        "final_consent"
      ],
      "rule": "Name and email required. final_consent must be true."
    }
  },
  "derived_fields": {
    "age_range": {
      "source": "date_of_birth",
      "logic": [
        {
          "if_age_between": [
            18,
            24
          ],
          "value": "18-24"
        },
        {
          "if_age_between": [
            25,
            34
          ],
          "value": "25-34"
        },
        {
          "if_age_between": [
            35,
            44
          ],
          "value": "35-44"
        },
        {
          "if_age_gte": 45,
          "value": "45+"
        }
      ]
    }
  },
  "steps": [
    {
      "step": 1,
      "title": "Consent & Terms",
      "subtitle": "Let's start by reviewing our terms and consent",
      "fields": [
        {
          "key": "consent_agreed",
          "type": "boolean",
          "label": "I accept the terms and conditions and understand that this is not medical advice",
          "required": true
        }
      ],
      "content_notes": [
        "Links to /terms and /privacy",
        "States the assessment is for educational and informational purposes only",
        "States it is not medical advice"
      ]
    },
    {
      "step": 2,
      "title": "Emotional Motivators",
      "subtitle": "What would reaching your goal mean for you?",
      "selection_mode": "multi_select",
      "fields": [
        {
          "key": "emotional_motivators",
          "type": "string[]",
          "required": true,
          "options": [
            {
              "value": "energy",
              "label": "Having more energy"
            },
            {
              "value": "confidence",
              "label": "Feeling more confident"
            },
            {
              "value": "health",
              "label": "Improving overall health"
            },
            {
              "value": "body_image",
              "label": "Feeling better in my body"
            },
            {
              "value": "clothes",
              "label": "Feeling good in clothes"
            },
            {
              "value": "longevity",
              "label": "Living a longer, healthier life"
            }
          ]
        }
      ]
    },
    {
      "step": 3,
      "title": "Specific Goals",
      "subtitle": "What are your specific goals?",
      "selection_mode": "multi_select",
      "fields": [
        {
          "key": "goals",
          "type": "string[]",
          "required": true,
          "groups": [
            {
              "group_name": "Weight Management",
              "options": [
                {
                  "value": "weight_5_10kg",
                  "label": "Lose 5-10 kg"
                },
                {
                  "value": "weight_10_20kg",
                  "label": "Lose 10-20 kg"
                },
                {
                  "value": "weight_20plus",
                  "label": "Lose 20+ kg"
                },
                {
                  "value": "weight_maintain",
                  "label": "Maintain current weight"
                }
              ]
            },
            {
              "group_name": "Other Health Goals",
              "options": [
                {
                  "value": "energy_mild",
                  "label": "Mild fatigue / Energy boost"
                },
                {
                  "value": "energy_chronic",
                  "label": "Chronic fatigue recovery"
                },
                {
                  "value": "recovery_athletic",
                  "label": "Athletic recovery"
                },
                {
                  "value": "muscle_building",
                  "label": "Build muscle mass"
                },
                {
                  "value": "body_recomposition",
                  "label": "Body recomposition"
                },
                {
                  "value": "anti_aging",
                  "label": "Anti-aging / Longevity"
                },
                {
                  "value": "cognitive_function",
                  "label": "Cognitive enhancement"
                },
                {
                  "value": "immune_support",
                  "label": "Immune system support"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "step": 4,
      "title": "Physical Measurements",
      "subtitle": "Help us understand your current metrics",
      "fields": [
        {
          "key": "height_cm",
          "type": "number",
          "label": "Height (in cm)",
          "required": true,
          "placeholder": "159"
        },
        {
          "key": "weight_kg",
          "type": "number",
          "label": "Current Weight (in kg)",
          "required": true,
          "placeholder": "80"
        },
        {
          "key": "waist_inches",
          "type": "number",
          "label": "Waist Size (in inches)",
          "required": false,
          "placeholder": "29"
        },
        {
          "key": "hip_inches",
          "type": "number",
          "label": "Hip Size (in inches)",
          "required": false,
          "placeholder": "38"
        }
      ]
    },
    {
      "step": 5,
      "title": "Basic Information",
      "subtitle": "Help us personalize your recommendations",
      "fields": [
        {
          "key": "date_of_birth",
          "type": "date",
          "label": "Date of Birth",
          "required": true,
          "notes": [
            "User must be at least 18 years old to continue."
          ]
        },
        {
          "key": "sex_assigned",
          "type": "enum",
          "label": "Sex Assigned at Birth",
          "required": true,
          "options": [
            {
              "value": "male",
              "label": "male"
            },
            {
              "value": "female",
              "label": "female"
            },
            {
              "value": "other",
              "label": "other"
            }
          ]
        },
        {
          "key": "location",
          "type": "string",
          "label": "Location",
          "required": true,
          "placeholder": "e.g., Metro Manila, Philippines"
        }
      ]
    },
    {
      "step": 6,
      "title": "Pregnancy / Reproductive",
      "subtitle": "Are you currently:",
      "selection_mode": "multi_select",
      "fields": [
        {
          "key": "pregnancy_status",
          "type": "string[]",
          "required": false,
          "options": [
            {
              "value": "breastfeeding",
              "label": "Breastfeeding"
            },
            {
              "value": "pregnant",
              "label": "Pregnant"
            },
            {
              "value": "planning_pregnancy",
              "label": "Planning to be pregnant in the next 2 months"
            },
            {
              "value": "none",
              "label": "None of the above"
            }
          ]
        }
      ]
    },
    {
      "step": 7,
      "title": "Medical History",
      "subtitle": "Do you have a medical history of the following conditions?",
      "selection_mode": "multi_select",
      "fields": [
        {
          "key": "medical_conditions",
          "type": "string[]",
          "required": false,
          "options": [
            {
              "value": "Medullary Thyroid Carcinoma / Multiple Endocrine Neoplasia",
              "label": "Medullary Thyroid Carcinoma / Multiple Endocrine Neoplasia"
            },
            {
              "value": "Thyroid Problems (goiter, Graves' disease, hypothyroid, hyperthyroid)",
              "label": "Thyroid Problems (goiter, Graves' disease, hypothyroid, hyperthyroid)"
            },
            {
              "value": "Thyroid Cancer",
              "label": "Thyroid Cancer"
            },
            {
              "value": "Pancreatitis",
              "label": "Pancreatitis"
            },
            {
              "value": "Gallbladder problems",
              "label": "Gallbladder problems"
            },
            {
              "value": "Gallstones",
              "label": "Gallstones"
            },
            {
              "value": "Low blood sugar",
              "label": "Low blood sugar"
            },
            {
              "value": "Kidney Problems",
              "label": "Kidney Problems"
            },
            {
              "value": "Vision Changes (Diabetic Retinopathy)",
              "label": "Vision Changes (Diabetic Retinopathy)"
            },
            {
              "value": "Hypersensitivity to peptides",
              "label": "Hypersensitivity to peptides"
            },
            {
              "value": "Heart Problems (abnormal rhythms, disease, attack, failure)",
              "label": "Heart Problems (abnormal rhythms, disease, attack, failure)"
            },
            {
              "value": "Mental Health Problems (severe anxiety, depression, schizophrenia, personality disorders)",
              "label": "Mental Health Problems (severe anxiety, depression, schizophrenia, personality disorders)"
            },
            {
              "value": "Eating Disorder (anorexia, bulimia, binge eating)",
              "label": "Eating Disorder (anorexia, bulimia, binge eating)"
            },
            {
              "value": "Severe Gastro-Intestinal Problems (IBD, gastroparesis)",
              "label": "Severe Gastro-Intestinal Problems (IBD, gastroparesis)"
            },
            {
              "value": "Liver Problems (hepatitis, fatty liver, alcohol liver disease)",
              "label": "Liver Problems (hepatitis, fatty liver, alcohol liver disease)"
            },
            {
              "value": "None of the above",
              "label": "None of the above"
            }
          ]
        }
      ]
    },
    {
      "step": 8,
      "title": "Family History",
      "subtitle": "Do you have family history with any of the following conditions?",
      "selection_mode": "multi_select",
      "fields": [
        {
          "key": "family_history_conditions",
          "type": "string[]",
          "required": false,
          "options": [
            {
              "value": "Thyroid cancer or disorders",
              "label": "Thyroid cancer or disorders"
            },
            {
              "value": "Heart disease",
              "label": "Heart disease"
            },
            {
              "value": "Mental health issues (severe)",
              "label": "Mental health issues (severe)"
            },
            {
              "value": "Eating disorders",
              "label": "Eating disorders"
            },
            {
              "value": "Liver or kidney problems",
              "label": "Liver or kidney problems"
            },
            {
              "value": "GI issues",
              "label": "GI issues"
            },
            {
              "value": "Pancreatitis",
              "label": "Pancreatitis"
            },
            {
              "value": "Gallbladder problems",
              "label": "Gallbladder problems"
            },
            {
              "value": "Diabetic complications",
              "label": "Diabetic complications"
            },
            {
              "value": "None of the above",
              "label": "None of the above"
            }
          ]
        }
      ]
    },
    {
      "step": 9,
      "title": "Medications / Surgeries / Allergies",
      "subtitle": "Please list all medications you are currently taking",
      "fields": [
        {
          "key": "current_medications",
          "type": "text",
          "label": "Current Medications",
          "required": false,
          "placeholder": "e.g., Metformin 500mg, twice daily\\nVitamin D 1000IU, once daily"
        },
        {
          "key": "previous_surgeries",
          "type": "boolean",
          "label": "Have you had any previous surgeries?",
          "required": false
        },
        {
          "key": "previous_surgeries_details",
          "type": "text",
          "label": "Please specify surgery and year",
          "required": false,
          "conditional_on": {
            "field": "previous_surgeries",
            "equals": true
          },
          "placeholder": "e.g. Appendectomy (2018), ACL Repair (2020)"
        },
        {
          "key": "drug_allergies",
          "type": "boolean",
          "label": "Do you have any food or drug allergies?",
          "required": false
        },
        {
          "key": "drug_allergies_details",
          "type": "text",
          "label": "Please list your allergies",
          "required": false,
          "conditional_on": {
            "field": "drug_allergies",
            "equals": true
          },
          "placeholder": "e.g. Penicillin, Peanuts, Shellfish"
        }
      ]
    },
    {
      "step": 10,
      "title": "Lifestyle & Experience",
      "subtitle": "Tell us about your peptide experience and habits",
      "fields": [
        {
          "key": "experience_level",
          "type": "enum",
          "label": "Peptide Experience Level",
          "required": true,
          "options": [
            {
              "value": "first_time",
              "label": "First-time (Never used peptides)"
            },
            {
              "value": "beginner",
              "label": "Beginner (Some experience)"
            },
            {
              "value": "experienced",
              "label": "Experienced (Regular user)"
            }
          ]
        },
        {
          "key": "peptide_experience_first_time",
          "type": "boolean",
          "label": "Is this your first time using any GLP-1 medication (Ozempic, Wegovy, Mounjaro, etc.)?",
          "required": false
        },
        {
          "key": "current_prescription_glp1",
          "type": "boolean",
          "label": "Do you have a current prescription for GLP-1 medications?",
          "required": false,
          "notes": [
            "UI note: Don't worry if you don't have one, we can help with recommendations."
          ]
        },
        {
          "key": "smoking_status",
          "type": "enum",
          "label": "Smoking Status",
          "required": true,
          "options": [
            {
              "value": "smoker",
              "label": "smoker"
            },
            {
              "value": "non_smoker",
              "label": "non-smoker"
            },
            {
              "value": "other",
              "label": "other"
            }
          ]
        }
      ]
    },
    {
      "step": 11,
      "title": "Preferences",
      "subtitle": "Help us tailor our recommendations",
      "fields": [
        {
          "key": "preferences.budget",
          "type": "enum",
          "label": "Budget Range",
          "required": false,
          "options": [
            {
              "value": "budget",
              "label": "Budget-friendly (Entry level)"
            },
            {
              "value": "mid_range",
              "label": "Mid-range (Quality balance)"
            },
            {
              "value": "premium",
              "label": "Premium (Best quality)"
            }
          ]
        },
        {
          "key": "preferences.frequency",
          "type": "enum",
          "label": "Preferred Dosing Frequency",
          "required": false,
          "options": [
            {
              "value": "daily",
              "label": "Daily (Most convenient)"
            },
            {
              "value": "weekly",
              "label": "Weekly"
            },
            {
              "value": "flexible",
              "label": "Flexible schedule"
            }
          ]
        }
      ]
    },
    {
      "step": 12,
      "title": "Contact & Final Consent",
      "subtitle": "We'll send your personalized recommendations to this email",
      "fields": [
        {
          "key": "full_name",
          "type": "string",
          "label": "Full Name",
          "required": true,
          "placeholder": "Juan Dela Cruz"
        },
        {
          "key": "email",
          "type": "email",
          "label": "Email",
          "required": true,
          "placeholder": "name@example.com"
        },
        {
          "key": "phone",
          "type": "tel",
          "label": "Phone",
          "required": false,
          "placeholder": "+63 912 345 6789"
        },
        {
          "key": "final_consent",
          "type": "boolean",
          "label": "I confirm that all information provided is accurate and I consent to receive personalized peptide recommendations based on this assessment",
          "required": true
        }
      ]
    }
  ],
  "submit_payload": {
    "full_name": "string",
    "email": "string",
    "phone": "string|null",
    "age_range": "derived string",
    "date_of_birth": "date",
    "sex_assigned": "male|female|other",
    "location": "string",
    "height_cm": "number",
    "weight_kg": "number",
    "waist_inches": "number|null",
    "hip_inches": "number|null",
    "goals": "string[]",
    "emotional_motivators": "string[]",
    "experience_level": "string",
    "peptide_experience_first_time": "boolean|null",
    "current_prescription_glp1": "boolean|null",
    "medical_conditions": "string[]",
    "family_history_conditions": "string[]",
    "current_medications": "string|null",
    "previous_surgeries": "boolean|null",
    "previous_surgeries_details": "string|null",
    "drug_allergies": "boolean|null",
    "drug_allergies_details": "string|null",
    "smoking_status": "smoker|non_smoker|other",
    "pregnancy_status": "string[]",
    "preferences": {
      "budget": "budget|mid_range|premium",
      "frequency": "daily|weekly|flexible"
    },
    "consent_agreed": true,
    "status": "new"
  },
